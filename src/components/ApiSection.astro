---
import { Image } from "astro:assets";
import telegramDark from "../assets/telegram-hermes-dark.png";
import { SECTION_IDS } from "../consts";
---

<section
  id={SECTION_IDS.api}
  class="relative scroll-mt-24 px-4 pt-20 sm:px-6 lg:px-14 lg:pt-24"
>
  <!-- This panel stays dark in both themes; it is the page's contrast block. -->
  <div
    class="grid grid-cols-1 items-end gap-8 overflow-hidden rounded-3xl bg-[linear-gradient(180deg,#131a0d,#0a0d0a)] px-6 pt-10 shadow-[0_50px_100px_-50px_rgba(23,28,18,0.9)] sm:px-10 sm:pt-13 lg:grid-cols-[1fr_0.8fr] lg:gap-10 lg:px-12"
  >
    <div class="flex flex-col gap-4.5 pb-10 text-[#eef1e8] sm:pb-13">
      <h2
        class="m-0 text-[clamp(1.9rem,5.5vw,42px)] leading-[1.03] font-bold tracking-[-0.035em]"
      >
        Your bots can<br />keep the books.
      </h2>

      <p
        class="m-0 max-w-105 text-[17px] leading-relaxed text-pretty text-[#9aa38f]"
      >
        Wiwit comes with a complete REST API. Build personal finance agents,
        automate workflows, or integrate with your tools. The Telegram example
        is just one showcase of what's possible.{" "}
        <a
          href="https://demo-wiwit.iqfareez.com/swagger"
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand-bright hover:underline"
        >
          See the API documentation example.
        </a>
      </p>
    </div>

    <div class="flex justify-center">
      <Image
        src={telegramDark}
        alt="Telegram agent logging a receipt through the Wiwit API"
        widths={[320, 560, 640]}
        sizes="(min-width: 640px) 280px, 320px"
        class="block w-72 rounded-t-[22px] border-7 border-b-0 border-[#22271b] shadow-[0_40px_70px_-30px_rgba(0,0,0,0.9)] sm:w-70"
      />
    </div>
  </div>
</section>
