---
import { LINKS, SECTION_IDS } from "../consts";
import Button from "./Button.astro";
---

<section
  id={SECTION_IDS.selfHost}
  class="relative scroll-mt-24 px-4 pt-20 sm:px-6 lg:px-14 lg:pt-28"
>
  <div
    class="surface-cta border-line-brand shadow-panel relative overflow-hidden rounded-[22px] border px-6 py-12 text-center sm:px-14 sm:py-14"
  >
    <div
      class="cta-glow pointer-events-none absolute -bottom-50 left-1/2 h-105 w-175 -translate-x-1/2"
    >
    </div>

    <div class="relative flex flex-col items-center gap-4.5">
      <h2
        class="m-0 max-w-160 text-[clamp(1.9rem,6vw,46px)] leading-[1.02] font-bold tracking-[-0.035em] text-balance"
      >
        One compose file away from owning your finances.
      </h2>

      <p
        class="text-ink-muted m-0 max-w-130 text-[17px] leading-relaxed text-pretty"
      >
        Your data deserves to live on your own server. Our deployment guide walks
        you through everything you need to get Wiwit running.
      </p>

      <Button
        href={LINKS.docs}
        class="mt-4 rounded-xl px-7 py-3.75 text-[15.5px]"
      >
        Read the docs
      </Button>
    </div>
  </div>
</section>
