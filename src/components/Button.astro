---
const VARIANTS = {
  primary: "button-primary font-bold",
  secondary:
    "surface border-line text-ink shadow-card border font-medium hover:border-brand",
} as const;

interface Props {
  href: string;
  variant?: keyof typeof VARIANTS;
  class?: string;
}

const { href, variant = "primary", class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-block text-center whitespace-nowrap transition-[scale,filter,border-color] duration-200 ease-out hover:brightness-110 motion-safe:active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand motion-reduce:transition-none",
    VARIANTS[variant],
    className,
  ]}
>
  <slot />
</a>
