---
import { LINKS, SECTION_IDS } from "../consts";
import Logo from "./Logo.astro";

const NAV_LINKS = [
  { label: "Features", href: `#${SECTION_IDS.features}` },
  { label: "Docs", href: LINKS.docs },
  { label: "GitHub", href: LINKS.github },
] as const;
---

<header class="relative flex justify-center px-4 pt-5 sm:px-6">
  <nav
    class="surface-nav border-line shadow-nav inset-shadow-surface flex items-center gap-4 rounded-full border py-2.25 pr-5 pl-4 backdrop-blur-xl sm:gap-6 sm:pl-5 md:gap-6.5"
  >
    <a href="/" class="flex items-center gap-2.25">
      <Logo class="h-5.5 w-5.5" />
      <span class="text-[17px] font-bold tracking-[-0.02em]">Wiwit</span>
      <span
        class="-ml-1 inline-flex items-center rounded-full border border-red-300 bg-red-50 px-2 py-0.5 text-xs font-semibold text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-200"
        >alpha</span
      >
    </a>

    <div class="text-ink-muted hidden items-center gap-5.5 text-sm md:flex">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} class="hover:text-brand">
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
