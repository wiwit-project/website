---
import ApiSection from "../components/ApiSection.astro";
import Features from "../components/Features.astro";
import Hero from "../components/Hero.astro";
import LogoScatter from "../components/LogoScatter.astro";
import SelfHostCta from "../components/SelfHostCta.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="relative mx-auto w-full max-w-7xl overflow-hidden">
    <!-- Lime bloom bleeding in from above the fold. -->
    <div
      class="hero-glow pointer-events-none absolute -top-55 left-1/2 h-155 w-250 max-w-full -translate-x-1/2"
    >
    </div>

    <SiteNav />
    <Hero />
    <Features />
    <ApiSection />
    <SelfHostCta />
    <SiteFooter />
    <LogoScatter />
  </main>
</Layout>
